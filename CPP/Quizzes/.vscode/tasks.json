// .vscode/tasks.json
{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build",
			"type": "shell",
			"command": "g++",
			"args": [
				"-g",
				"-std=c++20",
				"-pthread",
				"-O0",
				"-Wall",
				"-Wextra",
				"-Wpedantic",
				"-Werror",
				"-Wshadow",
				//	"${workspaceFolder}/quiz4.cpp",
				// "${workspaceFolder}/DynamicAllocationOnly.cpp",
				//"MyFile.cpp",
				//"find_issues.cpp",
				//"quiz3.cpp",
				//"quiz1.cpp",
				"FixedSizeBuffer.cpp",
				"-o",
				"${workspaceFolder}/bin/app"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [
				"$gcc"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "valgrind",
			"type": "shell",
			"command": "valgrind",
			"args": [
				"--leak-check=full",
				"--show-leak-kinds=all",
				"--track-origins=yes",
				"-s",
				"${workspaceFolder}/bin/app"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared"
			},
			"group": {
				"kind": "test",
				"isDefault": false
			}
		}
	]
}